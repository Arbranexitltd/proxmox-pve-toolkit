# ==============================================================================
# Proxmox VE Toolkit Configuration (.env)
# ==============================================================================
# Connection Details
PROXMOX_HOST=pve1.lab.internal
PROXMOX_PORT=8006
VERIFY_SSL=false

# Authentication via API Token (Recommended & Least Privilege)
# Format: <username>@<realm>!<tokenid>
PROXMOX_USER=root@pam
PROXMOX_TOKEN_NAME=pve-toolkit-token
PROXMOX_TOKEN_VALUE=00000000-0000-0000-0000-000000000000

# Optional Password Authentication (Fallback - Not recommended for automation)
# PROXMOX_PASSWORD=SuperSecretPassword123!

# Global Defaults
DEFAULT_NODE=pve1
LOG_LEVEL=INFO
OUTPUT_FORMAT=table   # Options: table, json, yaml
REQUEST_TIMEOUT=30
